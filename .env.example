# =============================================================================
# wispoke-voice — Environment Variables
# =============================================================================
# Copy to .env and fill in. NEVER commit .env.

# --- Wispoke API (worker calls back into this for tenant + booking actions) ---
WISPOKE_API_URL=http://localhost:8081

# Service JWT secret — must match VOICE_SERVICE_JWT_SECRET in wispoke-api/.env.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WISPOKE_SERVICE_JWT_SECRET=

# --- LiveKit Cloud ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=...

# --- Provider keys ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Call recording (LiveKit Egress → Supabase Storage, S3-compatible) ---
# Leave the S3 creds blank to disable recording (calls + transcripts still work).
# 1. Create a PRIVATE bucket named below in Supabase → Storage.
# 2. Generate S3 access keys in Supabase → Project Settings → Storage → S3 access.
RECORDING_ENABLED=true
RECORDING_BUCKET=call-recordings
# Endpoint: https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_ENDPOINT=
# Region shown next to the S3 endpoint in the Supabase dashboard (e.g. eu-central-1)
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET=

# --- Optional: logging ---
LOG_LEVEL=INFO
