# =============================================================================
# wispoke-voice — Environment Variables
# =============================================================================
# Copy to .env and fill in. NEVER commit .env.

# --- Wispoke API (worker calls back into this for tenant + booking actions) ---
WISPOKE_API_URL=http://localhost:8081

# Service JWT secret — must match VOICE_SERVICE_JWT_SECRET in wispoke-api/.env.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WISPOKE_SERVICE_JWT_SECRET=

# --- LiveKit Cloud ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=...

# --- Provider keys ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional: logging ---
LOG_LEVEL=INFO
